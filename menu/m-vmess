# COLOR SCHEME
CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
WHITE='\033[1;37m'
NC='\033[0m'

clear
echo -e ""
echo -e "${CYAN}╔═══════════════════════════════════════════════════════════════╗${NC}"
echo -e "${CYAN}║${NC}${WHITE}              📡 BRILLTUNNEL VPN - VMESS MENU 📡              ${NC}${CYAN}║${NC}"
echo -e "${CYAN}╠═══════════════════════════════════════════════════════════════╣${NC}"
echo -e "${CYAN}║${NC}  ${YELLOW}[1]${NC} Create VMess Account (WS/GRPC)"
echo -e "${CYAN}║${NC}  ${YELLOW}[2]${NC} Create Trial VMess Account"
echo -e "${CYAN}║${NC}  ${YELLOW}[3]${NC} Delete VMess Account"
echo -e "${CYAN}║${NC}  ${YELLOW}[4]${NC} Renew VMess Account"
echo -e "${CYAN}║${NC}  ${YELLOW}[5]${NC} Check VMess Login"
echo -e "${CYAN}║${NC}  ${YELLOW}[6]${NC} List VMess Accounts"
echo -e "${CYAN}╠═══════════════════════════════════════════════════════════════╣${NC}"
echo -e "${CYAN}║${NC}  ${RED}[0]${NC} Back to Main Menu"
echo -e "${CYAN}╚═══════════════════════════════════════════════════════════════╝${NC}"
echo -e ""
read -p " Select Menu [0-6]: " menu
case $menu in
1) clear ; addws ;;
2) clear ; trialws ;;
3) clear ; delws ;;
4) clear ; renewws ;;
5) clear ; cekws ;;
6) clear ; member-ws ;;
*) clear ; menu ;;
esac
