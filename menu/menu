#!/bin/bash
# ═══════════════════════════════════════════════════════════════
# BrillTunnel VPN - Premium Tunneling Solution
# ═══════════════════════════════════════════════════════════════
clear

# COLOR SCHEME
CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
WHITE='\033[1;37m'
NC='\033[0m'
BOLD='\033[1m'

# SYSTEM INFO
ISP=$(cat /root/.info/.isp 2>/dev/null || echo "Unknown")
CITY=$(cat /root/.info/.city 2>/dev/null || echo "Unknown")
IPVPS=$(curl -s ipv4.icanhazip.com)
NS=$(cat /etc/xray/dns 2>/dev/null || echo "Not Set")
domain=$(cat /etc/xray/domain 2>/dev/null || echo "Not Set")
RAM=$(free -m | awk 'NR==2 {print $2}')
USAGERAM=$(free -m | awk 'NR==2 {print $3}')
MEMOFREE=$(printf '%-1s' "$(free -m | awk 'NR==2{printf "%.2f%%", $3*100/$2 }')")
MODEL=$(cat /etc/os-release | grep -w PRETTY_NAME | head -n1 | sed 's/=//g' | sed 's/"//g' | sed 's/PRETTY_NAME//g')
CORE=$(printf '%-1s' "$(grep -c cpu[0-9] /proc/stat)")
DATEVPS=$(date +'%d-%m-%Y')
TIMEZONE=$(printf '%(%H:%M:%S)T')
SERONLINE=$(uptime -p | cut -d " " -f 2-10000)
tram=$(free -m | awk 'NR==2 {print $2}')

# SERVICE STATUS CHECK
ssh_service=$(/etc/init.d/ssh status 2>/dev/null | grep Active | awk '{print $3}' | cut -d "(" -f2 | cut -d ")" -f1)
dropbear_service=$(/etc/init.d/dropbear status 2>/dev/null | grep Active | awk '{print $3}' | cut -d "(" -f2 | cut -d ")" -f1)
haproxy_service=$(systemctl status haproxy 2>/dev/null | grep Active | awk '{print $3}' | cut -d "(" -f2 | cut -d ")" -f1)
xray_service=$(systemctl status xray 2>/dev/null | grep Active | awk '{print $3}' | cut -d "(" -f2 | cut -d ")" -f1)
nginx_service=$(systemctl status nginx 2>/dev/null | grep Active | awk '{print $3}' | cut -d "(" -f2 | cut -d ")" -f1)
ssh_ws=$(systemctl status ws 2>/dev/null | grep Active | awk '{print $3}' | sed 's/(//g' | sed 's/)//g')

# STATUS INDICATORS
[[ $ssh_service == "running" ]] && status_ssh="${GREEN}● ON${NC}" || status_ssh="${RED}○ OFF${NC}"
[[ $ssh_ws == "running" ]] && status_ws="${GREEN}● ON${NC}" || status_ws="${RED}○ OFF${NC}"
[[ $haproxy_service == "running" ]] && status_haproxy="${GREEN}● ON${NC}" || status_haproxy="${RED}○ OFF${NC}"
[[ $xray_service == "running" ]] && status_xray="${GREEN}● ON${NC}" || status_xray="${RED}○ OFF${NC}"
[[ $nginx_service == "running" ]] && status_nginx="${GREEN}● ON${NC}" || status_nginx="${RED}○ OFF${NC}"
[[ $dropbear_service == "running" ]] && status_dropbear="${GREEN}● ON${NC}" || status_dropbear="${RED}○ OFF${NC}"

# ACCOUNT COUNT
vlx=$(grep -c -E "^#& " "/etc/xray/config.json" 2>/dev/null || echo 0)
let vla=$vlx/2
vmc=$(grep -c -E "^### " "/etc/xray/config.json" 2>/dev/null || echo 0)
let vma=$vmc/2
ssh1="$(awk -F: '$3 >= 1000 && $1 != "nobody" {print $1}' /etc/passwd | wc -l)"
trx=$(grep -c -E "^#! " "/etc/xray/config.json" 2>/dev/null || echo 0)
let trb=$trx/2
ssx=$(grep -c -E "^#ss# " "/etc/xray/config.json" 2>/dev/null || echo 0)
let ssa=$ssx/2

clear
echo -e ""
echo -e "${CYAN}╔═══════════════════════════════════════════════════════════════╗${NC}"
echo -e "${CYAN}║${NC}${WHITE}${BOLD}          🚀 BRILLTUNNEL VPN - PREMIUM PANEL 🚀              ${NC}${CYAN}║${NC}"
echo -e "${CYAN}╠═══════════════════════════════════════════════════════════════╣${NC}"
echo -e "${CYAN}║${NC}  ${YELLOW}System${NC}    : $MODEL"
echo -e "${CYAN}║${NC}  ${YELLOW}ISP${NC}       : $ISP"
echo -e "${CYAN}║${NC}  ${YELLOW}City${NC}      : $CITY"
echo -e "${CYAN}║${NC}  ${YELLOW}RAM${NC}       : $tram MB"
echo -e "${CYAN}║${NC}  ${YELLOW}CPU Core${NC}  : $CORE vCPU"
echo -e "${CYAN}║${NC}  ${YELLOW}Uptime${NC}    : $SERONLINE"
echo -e "${CYAN}║${NC}  ${YELLOW}Date${NC}      : $DATEVPS"
echo -e "${CYAN}║${NC}  ${YELLOW}Time${NC}      : $TIMEZONE"
echo -e "${CYAN}║${NC}  ${YELLOW}Domain${NC}    : $domain"
echo -e "${CYAN}║${NC}  ${YELLOW}IP${NC}        : $IPVPS"
echo -e "${CYAN}╠═══════════════════════════════════════════════════════════════╣${NC}"
echo -e "${CYAN}║${NC}${WHITE}${BOLD}                    📊 ACCOUNT STATISTICS                      ${NC}${CYAN}║${NC}"
echo -e "${CYAN}╠═══════════════════════════════════════════════════════════════╣${NC}"
echo -e "${CYAN}║${NC}  ${GREEN}SSH/OVPN${NC}     : $ssh1 users    ${GREEN}VMESS${NC}      : $vma users"
echo -e "${CYAN}║${NC}  ${GREEN}VLESS${NC}        : $vla users    ${GREEN}TROJAN${NC}     : $trb users"
echo -e "${CYAN}║${NC}  ${GREEN}SHADOWSOCKS${NC}  : $ssa users"
echo -e "${CYAN}╠═══════════════════════════════════════════════════════════════╣${NC}"
echo -e "${CYAN}║${NC}${WHITE}${BOLD}                     ⚡ SERVICE STATUS                         ${NC}${CYAN}║${NC}"
echo -e "${CYAN}╠═══════════════════════════════════════════════════════════════╣${NC}"
echo -e "${CYAN}║${NC}  SSH: $status_ssh   NGINX: $status_nginx   XRAY: $status_xray   HAPROXY: $status_haproxy"
echo -e "${CYAN}║${NC}  WS: $status_ws   DROPBEAR: $status_dropbear"
echo -e "${CYAN}╠═══════════════════════════════════════════════════════════════╣${NC}"
echo -e "${CYAN}║${NC}${WHITE}${BOLD}                       📋 MAIN MENU                            ${NC}${CYAN}║${NC}"
echo -e "${CYAN}╠═══════════════════════════════════════════════════════════════╣${NC}"
echo -e "${CYAN}║${NC}  ${YELLOW}[1]${NC} Menu SSH          ${YELLOW}[5]${NC} Menu Shadowsocks"
echo -e "${CYAN}║${NC}  ${YELLOW}[2]${NC} Menu VMess        ${YELLOW}[6]${NC} Menu Utility"
echo -e "${CYAN}║${NC}  ${YELLOW}[3]${NC} Menu VLess        ${YELLOW}[7]${NC} Speedtest"
echo -e "${CYAN}║${NC}  ${YELLOW}[4]${NC} Menu Trojan       ${YELLOW}[8]${NC} Settings"
echo -e "${CYAN}╠═══════════════════════════════════════════════════════════════╣${NC}"
echo -e "${CYAN}║${NC}  ${RED}[0]${NC} Exit"
echo -e "${CYAN}╚═══════════════════════════════════════════════════════════════╝${NC}"
echo -e "${CYAN}        ═══ BrillTunnel VPN - Fast & Secure Tunneling ═══${NC}"
echo -e ""
read -p " Select Menu [0-8]: " opt
echo -e ""
case $opt in
1 | 01)
clear
m-sshws
;;
2 | 02)
clear
m-vmess
;;
3 | 03)
clear
m-vless
;;
4 | 04)
clear
m-trojan
;;
5 | 05)
clear
m-ssws
;;
6 | 06)
clear
m-noob
;;
7 | 07)
clear
speedtest
menu
;;
8 | 08)
clear
menu-x
;;
0 | 00)
clear
exit
;;
