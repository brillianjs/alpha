#!/bin/bash
# ═══════════════════════════════════════════════════════════════
# BrillTunnel VPN - Utility Menu
# ═══════════════════════════════════════════════════════════════

# COLOR SCHEME
CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
WHITE='\033[1;37m'
NC='\033[0m'

export LC_ALL='en_US.UTF-8'
export LANG='en_US.UTF-8'

function garis() {
    echo -e "${CYAN}═══════════════════════════════════════════════════════════════${NC}"
}

function create(){
    clear
    echo -e ""
    echo -e "${CYAN}╔═══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${NC}${WHITE}              🆕 CREATE BRILLTUNNEL ACCOUNT 🆕               ${NC}${CYAN}║${NC}"
    echo -e "${CYAN}╚═══════════════════════════════════════════════════════════════╝${NC}"
    echo -e ""
    read -p " Username: " user
    read -p " Password: " pass
    read -p " Expired (days, 0 for unlimited): " exp
    read -p " IP Limit: " ip

    if [ ! -e /etc/brilltunnel/limit/ip/ ]; then
        mkdir -p /etc/brilltunnel/limit/ip/
    fi
    echo "$ip" > /etc/brilltunnel/limit/ip/$user

    BRILLTUNNEL --add-user $user $pass --expired-user $user $exp

    clear
    echo -e ""
    echo -e "${CYAN}╔═══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${NC}${WHITE}              ✅ ACCOUNT CREATED SUCCESSFULLY ✅              ${NC}${CYAN}║${NC}"
    echo -e "${CYAN}╠═══════════════════════════════════════════════════════════════╣${NC}"
    echo -e "${CYAN}║${NC}  Domain   : $(cat /etc/xray/domain 2>/dev/null)"
    echo -e "${CYAN}║${NC}  Username : $user"
    echo -e "${CYAN}║${NC}  Password : $pass"
    echo -e "${CYAN}║${NC}  IP Limit : $ip"
    echo -e "${CYAN}║${NC}  Expired  : $exp Days"
    echo -e "${CYAN}║${NC}  TCP STD  : 2082, 8080"
    echo -e "${CYAN}║${NC}  TCP SSL  : 8443"
    echo -e "${CYAN}╚═══════════════════════════════════════════════════════════════╝${NC}"
    echo -e ""
    read -n 1 -s -r -p " Press any key to continue..."
    m-noob
}

function delete(){
    clear
    echo -e ""
    echo -e "${CYAN}╔═══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${NC}${WHITE}              🗑️  DELETE BRILLTUNNEL ACCOUNT 🗑️               ${NC}${CYAN}║${NC}"
    echo -e "${CYAN}╚═══════════════════════════════════════════════════════════════╝${NC}"
    echo -e ""
    read -p " Username to delete: " user

    BRILLTUNNEL --remove-user $user

    clear
    echo -e "${GREEN}✅ User $user deleted successfully!${NC}"
    echo -e ""
    read -n 1 -s -r -p " Press any key to continue..."
    m-noob
}

function renew(){
    clear
    echo -e ""
    echo -e "${CYAN}╔═══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${NC}${WHITE}              🔄 RENEW BRILLTUNNEL ACCOUNT 🔄                 ${NC}${CYAN}║${NC}"
    echo -e "${CYAN}╚═══════════════════════════════════════════════════════════════╝${NC}"
    echo -e ""
    read -p " Username: " user
    read -p " Add days: " exp

    BRILLTUNNEL --renew-user $user --expired-user $user $exp

    clear
    echo -e "${GREEN}✅ User $user renewed for $exp days!${NC}"
    echo -e ""
    read -n 1 -s -r -p " Press any key to continue..."
    m-noob
}

function lock(){
    clear
    echo -e ""
    echo -e "${CYAN}╔═══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${NC}${WHITE}              🔒 LOCK BRILLTUNNEL ACCOUNT 🔒                  ${NC}${CYAN}║${NC}"
    echo -e "${CYAN}╚═══════════════════════════════════════════════════════════════╝${NC}"
    echo -e ""
    read -p " Username to lock: " user

    BRILLTUNNEL --block-user $user

    clear
    echo -e "${GREEN}✅ User $user has been locked!${NC}"
    echo -e ""
    read -n 1 -s -r -p " Press any key to continue..."
    m-noob
}

function show(){
    clear
    echo -e ""
    echo -e "${CYAN}╔═══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${NC}${WHITE}              👥 ALL BRILLTUNNEL USERS 👥                     ${NC}${CYAN}║${NC}"
    echo -e "${CYAN}╚═══════════════════════════════════════════════════════════════╝${NC}"
    echo -e ""
    BRILLTUNNEL --info-all-user | awk '/^\s*\+.*-> active/ {gsub(/(issued\(yyyymmdd\)|hash_key): [0-9a-f]+/, ""); print; getline; print; getline; getline; getline; print; print "═══════════════════"}'
    echo -e ""
    read -n 1 -s -r -p " Press any key to continue..."
    m-noob
}

function unlock(){
    clear
    echo -e ""
    echo -e "${CYAN}╔═══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${NC}${WHITE}              🔓 UNLOCK BRILLTUNNEL ACCOUNT 🔓                ${NC}${CYAN}║${NC}"
    echo -e "${CYAN}╚═══════════════════════════════════════════════════════════════╝${NC}"
    echo -e ""
    read -p " Username to unlock: " user

    BRILLTUNNEL --unblock-user $user

    clear
    echo -e "${GREEN}✅ User $user has been unlocked!${NC}"
    echo -e ""
    read -n 1 -s -r -p " Press any key to continue..."
    m-noob
}

function remove(){
    clear
    echo -e ""
    echo -e "${CYAN}╔═══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${NC}${RED}              ⚠️  REMOVE ALL USERS ⚠️                           ${NC}${CYAN}║${NC}"
    echo -e "${CYAN}╚═══════════════════════════════════════════════════════════════╝${NC}"
    echo -e ""
    read -p " Are you sure you want to remove ALL users? (Y/N): " choice

    if [ "$choice" == "Y" ] || [ "$choice" == "y" ]; then
        echo -e "${RED}Removing all users...${NC}"
        BRILLTUNNEL --remove-all-user
        echo -e "${GREEN}✅ All users have been removed!${NC}"
    else
        echo -e "${YELLOW}Operation cancelled.${NC}"
    fi
    echo -e ""
    read -n 1 -s -r -p " Press any key to continue..."
    m-noob
}

clear
echo -e ""
echo -e "${CYAN}╔═══════════════════════════════════════════════════════════════╗${NC}"
echo -e "${CYAN}║${NC}${WHITE}            🛠️  BRILLTUNNEL VPN - UTILITY MENU 🛠️              ${NC}${CYAN}║${NC}"
echo -e "${CYAN}╠═══════════════════════════════════════════════════════════════╣${NC}"
echo -e "${CYAN}║${NC}  ${YELLOW}[1]${NC} Create Account"
echo -e "${CYAN}║${NC}  ${YELLOW}[2]${NC} Delete Account"
echo -e "${CYAN}║${NC}  ${YELLOW}[3]${NC} Renew Account"
echo -e "${CYAN}║${NC}  ${YELLOW}[4]${NC} Lock Account"
echo -e "${CYAN}║${NC}  ${YELLOW}[5]${NC} Unlock Account"
echo -e "${CYAN}║${NC}  ${YELLOW}[6]${NC} Show All Users"
echo -e "${CYAN}║${NC}  ${YELLOW}[7]${NC} Remove All Users"
echo -e "${CYAN}╠═══════════════════════════════════════════════════════════════╣${NC}"
echo -e "${CYAN}║${NC}  ${RED}[0]${NC} Back to Main Menu"
echo -e "${CYAN}╚═══════════════════════════════════════════════════════════════╝${NC}"
echo -e ""
read -p " Select Menu [0-7]: " opt
echo -e ""
case $opt in
1) clear ; create ;;
2) clear ; delete ;;
3) clear ; renew ;;
4) clear ; lock ;;
5) clear ; unlock ;;
6) clear ; show ;;
7) clear ; remove ;;
0) clear ; menu ;;
*) clear ; menu ;;
esac
