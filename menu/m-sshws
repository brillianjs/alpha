#!/bin/bash
# ═══════════════════════════════════════════════════════════════
# BrillTunnel VPN - SSH & OpenVPN Menu
# ═══════════════════════════════════════════════════════════════

# COLOR SCHEME
CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
WHITE='\033[1;37m'
NC='\033[0m'

domain=$(cat /etc/xray/domain 2>/dev/null || echo "Not Set")

clear
echo -e ""
echo -e "${CYAN}╔═══════════════════════════════════════════════════════════════╗${NC}"
echo -e "${CYAN}║${NC}${WHITE}           🔑 BRILLTUNNEL VPN - SSH & OPENVPN MENU 🔑          ${NC}${CYAN}║${NC}"
echo -e "${CYAN}╠═══════════════════════════════════════════════════════════════╣${NC}"
echo -e "${CYAN}║${NC}  ${YELLOW}[1]${NC} Create SSH & OpenVPN Account"
echo -e "${CYAN}║${NC}  ${YELLOW}[2]${NC} Create Trial SSH & OpenVPN"
echo -e "${CYAN}║${NC}  ${YELLOW}[3]${NC} Renew SSH & OpenVPN Account"
echo -e "${CYAN}║${NC}  ${YELLOW}[4]${NC} Check User Login"
echo -e "${CYAN}║${NC}  ${YELLOW}[5]${NC} List All Users"
echo -e "${CYAN}║${NC}  ${YELLOW}[6]${NC} Delete SSH & OpenVPN Account"
echo -e "${CYAN}║${NC}  ${YELLOW}[7]${NC} Delete Expired Users"
echo -e "${CYAN}║${NC}  ${YELLOW}[8]${NC} Setup Autokill SSH"
echo -e "${CYAN}║${NC}  ${YELLOW}[9]${NC} Check Multi Login"
echo -e "${CYAN}║${NC}  ${YELLOW}[10]${NC} Lock User SSH"
echo -e "${CYAN}║${NC}  ${YELLOW}[11]${NC} Unlock User SSH"
echo -e "${CYAN}╠═══════════════════════════════════════════════════════════════╣${NC}"
echo -e "${CYAN}║${NC}  ${RED}[0]${NC} Back to Main Menu"
echo -e "${CYAN}╚═══════════════════════════════════════════════════════════════╝${NC}"
echo -e ""
read -p " Select Menu [0-11]: " menu
echo -e ""
case $menu in
1) addssh ;;
2) trial ;;
3) renewssh ;;
4) cekssh ;;
5) member ;;
6) delssh ;;
7) delexp ;;
8) autokill ;;
9) ceklim ;;
10) clear ; lock ;;
11) clear ; unlock ;;
*) menu ;;
esac
