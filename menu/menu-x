#!/bin/bash
# ═══════════════════════════════════════════════════════════════
# BrillTunnel VPN - Settings & Utility Menu
# ═══════════════════════════════════════════════════════════════
clear

# COLOR SCHEME
CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
WHITE='\033[1;37m'
NC='\033[0m'
BOLD='\033[1m'

# SYSTEM INFO
IPVPS=$(curl -s ipv4.icanhazip.com)

clear
echo -e ""
echo -e "${CYAN}╔═══════════════════════════════════════════════════════════════╗${NC}"
echo -e "${CYAN}║${NC}${WHITE}${BOLD}        ⚙️  BRILLTUNNEL VPN - SETTINGS & UTILITY ⚙️           ${NC}${CYAN}║${NC}"
echo -e "${CYAN}╠═══════════════════════════════════════════════════════════════╣${NC}"
echo -e "${CYAN}║${NC}  ${YELLOW}[01]${NC} Trial Menu           ${YELLOW}[08]${NC} Backup / Restore"
echo -e "${CYAN}║${NC}  ${YELLOW}[02]${NC} Delete Expired       ${YELLOW}[09]${NC} Renew Domain"
echo -e "${CYAN}║${NC}  ${YELLOW}[03]${NC} Auto Reboot          ${YELLOW}[10]${NC} Running Services"
echo -e "${CYAN}║${NC}  ${YELLOW}[04]${NC} Restart Services     ${YELLOW}[11]${NC} Register IP"
echo -e "${CYAN}║${NC}  ${YELLOW}[05]${NC} Telegram Bot         ${YELLOW}[12]${NC} Update Script"
echo -e "${CYAN}║${NC}  ${YELLOW}[06]${NC} Change Banner        ${YELLOW}[13]${NC} Fix SSL Cert"
echo -e "${CYAN}║${NC}  ${YELLOW}[07]${NC} Port Info            ${YELLOW}[14]${NC} Install UDP"
echo -e "${CYAN}╠═══════════════════════════════════════════════════════════════╣${NC}"
echo -e "${CYAN}║${NC}  ${RED}[0]${NC} Back to Main Menu"
echo -e "${CYAN}╠═══════════════════════════════════════════════════════════════╣${NC}"
echo -e "${CYAN}║${NC}  ${WHITE}IP Address${NC}: $IPVPS"
echo -e "${CYAN}╚═══════════════════════════════════════════════════════════════╝${NC}"
echo -e "${CYAN}        ═══ BrillTunnel VPN - Fast & Secure Tunneling ═══${NC}"
echo -e ""
read -p " Select Menu [0-14]: " opt
echo -e ""
case $opt in
1 | 01)
clear
m-trial
;;
2 | 02)
clear
xp
echo ""
echo -e " ${GREEN}Back to menu in 1 sec${NC}"
sleep 1
menu-x
;;
3 | 03)
clear
autoreboot
;;
4 | 04)
clear
restart
;;
5 | 05)
clear
m-bot
;;
6 | 06)
clear
echo -e "${CYAN}Edit Banner SSH Message${NC}"
sleep 2
echo -e "${YELLOW}Loading...${NC}"
sleep 3
nano /etc/kyt.txt
clear
echo -e "${GREEN}Apply this banner? ${NC}"
echo -e ""
read -p "Select option [Y/N]: " arg
if [[ $arg == 'Y' || $arg == 'y' ]]; then
  echo -e "${BLUE}Applying changes...${NC}"
  echo -e "${GREEN}Done!${NC}"
  sleep 2
  reboot
elif [[ $arg == 'N' || $arg == 'n' ]]; then
  echo -e "${RED}Cancelled${NC}"
  sleep 1
  clear
  menu
  exit 0
else
  echo -e "${RED}Invalid option${NC}"
  sleep 1
  clear
  menu-x
  exit 0
fi
;;
7 | 07)
clear
prot
;;
8 | 08)
clear
menu-backup
;;
9 | 09)
clear
addhost
;;
10)
clear
run
;;
11)
clear
regip
;;
12)
clear
wget -q https://raw.githubusercontent.com/brillianjs/alpha/main/update.sh
chmod +x update.sh
./update.sh
;;
13)
clear
fixcert
;;
14)
clear
echo -e "${GREEN}Install UDP Custom?${NC}"
echo -e "${YELLOW}Minimum RAM: 2GB${NC}"
echo -e "${YELLOW}Supported OS: Ubuntu 20.04${NC}"
echo -e ""
read -p "Continue? [Y/N]: " arg
if [[ $arg == 'Y' || $arg == 'y' ]]; then
  echo -e "${BLUE}Starting installation...${NC}"
  UDPX="https://docs.google.com/uc?export=download&confirm=$(wget --quiet --save-cookies /tmp/cookies.txt --keep-session-cookies --no-check-certificate 'https://docs.google.com/uc?export=download&id=1S3IE25v_fyUfCLslnujFBSBMNunDHDk2' -O- | sed -rn 's/.*confirm=([0-9A-Za-z_]+).*/\1\n/p')&id=1S3IE25v_fyUfCLslnujFBSBMNunDHDk2"
  wget --load-cookies /tmp/cookies.txt ${UDPX} -O install-udp && rm -rf /tmp/cookies.txt && chmod +x install-udp && ./install-udp
elif [[ $arg == 'N' || $arg == 'n' ]]; then
  echo -e "${RED}Cancelled${NC}"
  sleep 1
  clear
  menu-x
  exit 0
else
  echo -e "${RED}Invalid option${NC}"
  sleep 1
  clear
  menu-x
  exit 0
fi
;;
0 | 00)
clear
menu
;;
x)
menu-x
;;
*) clear ;
menu-x
;;
esac
