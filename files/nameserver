#!/bin/sh
REPOS="https://github.com/brillianjs/raw/alpha/"

setup_dnstt() {
	# Ambil domain dari konfigurasi yang sudah ada
	DOMAIN_PATH=$(cat /etc/xray/domain)
	NS_DOMAIN="ns.${DOMAIN_PATH}"

	echo "Setting up SlowDNS with domain: ${NS_DOMAIN}"
	echo $NS_DOMAIN >/etc/xray/dns

	cd
	rm -rf dnstt-server dnstt-client server.key server.pub
	mkdir -p /etc/slowdns
	wget -O dnstt-server "${REPOS}slowdns/dnstt-server" >/dev/null 2>&1
	chmod +x dnstt-server >/dev/null 2>&1
	wget -O dnstt-client "${REPOS}slowdns/dnstt-client" >/dev/null 2>&1
	chmod +x dnstt-client >/dev/null 2>&1
	./dnstt-server -gen-key -privkey-file server.key -pubkey-file server.pub
	chmod +x dnstt-server dnstt-client
	mv dnstt-server dnstt-client server.key server.pub /etc/slowdns/
	wget -O /etc/systemd/system/client.service "${REPOS}slowdns/client" >/dev/null 2>&1
	wget -O /etc/systemd/system/server.service "${REPOS}slowdns/server" >/dev/null 2>&1
	sed -i "s/xxxx/$NS_DOMAIN/g" /etc/systemd/system/client.service
	sed -i "s/xxxx/$NS_DOMAIN/g" /etc/systemd/system/server.service

	echo "SlowDNS setup completed."
	echo ""
	echo "PENTING: Anda perlu menambahkan NS record secara manual di DNS provider Anda:"
	echo "  - Buat NS record: ns.${DOMAIN_PATH} -> ${DOMAIN_PATH}"
	echo "  - Atau sesuaikan dengan konfigurasi DNS Anda"
}

setup_dnstt
